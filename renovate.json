{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules" : [
    {
      "description": "Auto merge Dependencies",
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": false,
      "ignoreTests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/docker-build-kubectl.yaml"
      ],
      "matchStrings": [
        "VERSION:\\s*(?<currentValue>[^\\s]+)\\s*# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)"
      ]
    }
  ]
}
